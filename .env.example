# Copy to .env for `npm run dev` on your computer. On Vercel, add these under Settings → Environment Variables.
# Your Neon connection string (Neon → Connect → "Pooled connection"). The Neon integration on Vercel adds this for you.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# A long random secret used to sign logins (at least 32 characters).
PMS_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# The first Super Admin, created on the very first start (only used once, while the database is empty).
PMS_ADMIN_EMAIL=you@yourcompany.com
PMS_ADMIN_PASSWORD=choose-a-strong-password
PMS_ADMIN_NAME=Super Admin
# Forgot password: emails the Super Admin(s) and the support email in Settings. Uses Resend (resend.com).
# Without these, nothing is emailed; the Super Admin still sees the request in the notification bell.
RESEND_API_KEY=
PMS_MAIL_FROM=Parva PMS <no-reply@yourcompany.com>
# The site address used in email links (optional on Vercel: the production domain is used).
PMS_APP_URL=https://your-site.vercel.app
